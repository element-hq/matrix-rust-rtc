{
  "name": "@element-hq/matrix-rtc",
  "version": "0.4.0-rc.1",
  "private": true,
  "description": "MatrixRTC (MSC4143) participation for web and Node: the matrix-rtc-uniffi crate compiled to WebAssembly, with TypeScript bindings generated by uniffi-bindgen-react-native.",
  "license": "AGPL-3.0-only OR LicenseRef-Element-Commercial",
  "repository": {
    "type": "git",
    "url": "https://github.com/element-hq/matrix-rust-rtc.git",
    "directory": "web-rtc"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./wasm": "./dist/generated/wasm-bindgen/index_bg.wasm",
    "./log-sink": {
      "types": "./dist/log-sink.d.ts",
      "default": "./dist/log-sink.js"
    },
    "./testing": {
      "types": "./dist/testing/mock-host.d.ts",
      "default": "./dist/testing/mock-host.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "ubrn:web": "ubrn build web --profile web --config ubrn.config.yaml",
    "check-pins": "node scripts/check-pins.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:pack": "bash scripts/pack-test.sh",
    "dev": "vite",
    "demo:build": "vite build --outDir demo-dist"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "binaryen": "^132.0.0",
    "typescript": "^7.0.2",
    "uniffi-bindgen-react-native": "0.31.0-5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
